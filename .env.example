OPENAI_API_KEY=

# Plateforme publique servie par ce déploiement : gcs | kimexdi | all (défaut)
# Figée au build : NEXT_PUBLIC_PLATFORM=kimexdi npm run build
NEXT_PUBLIC_PLATFORM=all

# Supabase — clés PUBLIQUES uniquement (la clé « publishable » est conçue
# pour le navigateur). Ne JAMAIS mettre de clé secrète/service_role ici ni
# dans une variable NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
